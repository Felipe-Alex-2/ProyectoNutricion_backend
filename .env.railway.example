# Configurar estas variables en el servicio backend de Railway.
# Sustituir los marcadores; no subir claves reales al repositorio.
ENVIRONMENT=production
SECRET_KEY=<CLAVE_ALEATORIA_1>
BACKUP_ENCRYPTION_KEY=<CLAVE_ALEATORIA_2>
DATABASE_URL=${{Postgres.DATABASE_URL}}
FRONTEND_URL=https://TU-DOMINIO-FRONTEND
CORS_ORIGINS=https://TU-DOMINIO-FRONTEND
# Con un volumen persistente montado en /data:
BACKUP_DIR=/data/backups
