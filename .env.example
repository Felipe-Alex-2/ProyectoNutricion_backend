# Database configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nutricion_db
TEST_DATABASE_URL=sqlite:///./test.db

# JWT Security
SECRET_KEY=change-this-in-production-to-a-super-secret-key-at-least-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Settings
ENVIRONMENT=development
PROJECT_NAME="Nutricion API"
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200","http://localhost:3000","http://localhost:8080"]

